{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "node": true },
  "ignorePatterns": [".claude/**", ".agents/**", ".scratch/**", "lib/database.types.ts", "next-env.d.ts"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": "off"
  },
  "overrides": [
    {
      "files": ["components/ui/**"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      "files": ["components/search-select.tsx"],
      "rules": { "jsx-a11y/role-has-required-aria-props": "off" }
    }
  ]
}
