{
  "name": "granite-inventory-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port $(cat .port 2>/dev/null || echo 3000)",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "comments": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/comments.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "db:push:staging": "supabase link --project-ref tyiepanibaqwpubajsya && supabase db push",
    "db:push:prod": "supabase link --project-ref nugnqzqglldacalkmgyn && supabase db push",
    "db:link:local": "supabase unlink",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "oxc-parser": "^0.151.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.9.0"
}
